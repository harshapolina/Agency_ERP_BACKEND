NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/agency-erp
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# Comma-separated list of allowed frontend origins (required for production login)
CORS_ORIGIN=http://localhost:3000,https://dashboards.editcomedia.com,https://dashboards-frontend.vercel.app
UPLOAD_DIR=./uploads
LOG_LEVEL=info

# Encrypts per-company MongoDB URIs and client-portal tokens (32+ random chars). Falls back to JWT_ACCESS_SECRET.
DATA_ENCRYPTION_KEY=
# Encrypts vault / product credentials. Falls back to DATA_ENCRYPTION_KEY.
PROJECT_VAULT_SECRET=
# Public URL of the frontend, used in email links and client-portal URLs
APP_URL=http://localhost:3000
# Bearer token required by GET /api/v1/cron/reminders?slot=morning|evening|deadline|recurring
CRON_SECRET=

# Platform SMTP (fallback; also copy onto companies via: npx tsx src/scripts/set-org-smtp.ts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Invoice details (logo, GST, bank, UPI) and notification recipients are set per company
# from Settings → Company in the dashboard, not here.
