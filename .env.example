NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/agency-erp
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# Comma-separated list of allowed frontend origins (required for production login)
CORS_ORIGIN=http://localhost:3000,https://dashboards.editcomedia.com,https://dashboards-frontend.vercel.app
UPLOAD_DIR=./uploads
LOG_LEVEL=info

# Encrypts per-company MongoDB URIs and client-portal tokens (32+ random chars). Falls back to JWT_ACCESS_SECRET.
DATA_ENCRYPTION_KEY=
# Encrypts vault / product credentials. Falls back to DATA_ENCRYPTION_KEY.
PROJECT_VAULT_SECRET=
# Public URL of the frontend, used in email links and client-portal URLs
APP_URL=http://localhost:3000
# Bearer token required by GET /api/v1/cron/reminders?slot=morning|evening|deadline|recurring
CRON_SECRET=

# SMTP (email is skipped when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Comma-separated inboxes that receive transaction / revenue alerts
FINANCE_ALERT_EMAILS=

# Seller details printed on invoices (never hardcode bank / GST details)
INVOICE_FROM_NAME=<COMPANY_LEGAL_NAME>
INVOICE_FROM_ADDRESS=<COMPANY_ADDRESS>
INVOICE_FROM_EMAIL=<BILLING_EMAIL>
INVOICE_FROM_PHONE=<BILLING_PHONE>
INVOICE_FROM_GST=<COMPANY_GSTIN>
INVOICE_FROM_PAN=<COMPANY_PAN>
INVOICE_FROM_CIN=
INVOICE_FROM_STATE=Karnataka
INVOICE_FROM_STATE_CODE=29
INVOICE_JURISDICTION=Bengaluru
INVOICE_LOGO_URL=
INVOICE_BANK_NAME=<BANK_NAME>
INVOICE_BANK_ACCOUNT_NAME=<BANK_ACCOUNT_NAME>
INVOICE_BANK_ACCOUNT_NUMBER=<BANK_ACCOUNT_NUMBER>
INVOICE_BANK_IFSC=<BANK_IFSC>
INVOICE_BANK_ACCOUNT_TYPE=Current Account
INVOICE_BANK_UPI=<UPI_ID>
